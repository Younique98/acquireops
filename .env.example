# Postgres connection - EITHER a single connection string (what Vercel
# Postgres/Neon/Supabase give you) OR the discrete fields below, not both.

# Option A: connection string (used automatically if set)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: discrete fields (local dev)
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=

# NextAuth - required. Generate NEXTAUTH_SECRET with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
